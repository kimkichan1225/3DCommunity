# ─────────────────────────────────────────────────────────────
# 환경변수 예시
#
# 배포 구성:
#   Frontend(React)  → Vercel
#   Backend(Spring)  → Railway
#   Database         → Supabase (PostgreSQL)
#
# 사용법:
#   1) 로컬 개발: 이 파일을 `.env.local` 로 복사 후 실제 값 입력
#   2) 운영 배포:
#      - 프론트엔드 변수(REACT_APP_*) → Vercel 대시보드의 Environment Variables 에 등록
#      - 백엔드 변수                  → Railway 대시보드의 Variables 탭에 등록
#   3) 실제 `.env*` 파일은 절대 깃에 커밋하지 말 것
# ─────────────────────────────────────────────────────────────


# ╔═══════════════════════════════════════════════════════════╗
# ║  FRONTEND (Vercel)                                         ║
# ║  → Vercel 프로젝트의 Environment Variables 에 등록         ║
# ╚═══════════════════════════════════════════════════════════╝

# Spring Boot REST API URL  (Railway 백엔드 도메인)
#  - 로컬:    http://localhost:8080
#  - 운영:    https://<your-backend>.up.railway.app
REACT_APP_API_URL=https://your-backend.up.railway.app

# WebSocket / STOMP 서버 URL  (실시간 멀티플레이, 글로벌 채팅, 미니게임)
#  - 통상 REACT_APP_API_URL 과 동일 호스트
#  - HTTPS 환경에서는 SockJS가 자동으로 wss:// 로 업그레이드됨
#  - 로컬:    http://localhost:8080
#  - 운영:    https://<your-backend>.up.railway.app
REACT_APP_SOCKET_URL=https://your-backend.up.railway.app

# Mapbox Access Token  (3D 지도 + 길찾기 Directions API)
#  발급: https://account.mapbox.com/access-tokens/
REACT_APP_MAPBOX_TOKEN=

# 토스페이먼츠 클라이언트 키  (결제 위젯)
#  - 테스트:  test_ck_*
#  - 실결제:  live_ck_*
#  발급: https://developers.tosspayments.com
REACT_APP_TOSS_CLIENT_KEY=

# (선택) Vercel 빌드 시 ESLint 경고로 실패 방지
# CI=false
# DISABLE_ESLINT_PLUGIN=true


# ╔═══════════════════════════════════════════════════════════╗
# ║  BACKEND (Railway)                                         ║
# ║  → Railway 백엔드 서비스의 Variables 탭에 등록             ║
# ║  ※ 이 파일 값은 빌드에 포함되지 않음 — 안내용 주석          ║
# ╚═══════════════════════════════════════════════════════════╝

# --- 서버 ---
# SERVER_PORT=8080                  # Railway는 PORT 변수를 자동 주입 (필요 시 매핑)
# LAZY_INIT=true                    # 콜드스타트 단축

# --- 데이터베이스 (Supabase PostgreSQL) ---
# ⚠️ 현재 application.yml 에 하드코딩되어 있음 — 운영 전 환경변수로 분리 + 비밀번호 회전 필수
# DB_URL=jdbc:postgresql://<host>.pooler.supabase.com:5432/postgres?sslmode=require&prepareThreshold=0
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<supabase-password>
# DB_DDL_AUTO=none                  # none | update | validate
# DB_SHOW_SQL=false

# --- CORS (Vercel 프론트 도메인 반드시 포함, 콤마 구분) ---
# CORS_ORIGINS=https://<your-app>.vercel.app,https://<your-custom-domain>

# --- JWT (운영 시 반드시 변경, 32자 이상 랜덤) ---
# JWT_SECRET=<random_secret_min_32_chars>
# JWT_EXPIRATION=3600000            # 1시간(ms)

# --- Toss Payments (서버측) ---
# TOSS_SECRET_KEY=<test_sk_or_live_sk>
# TOSS_CLIENT_KEY=<test_ck_or_live_ck>

# --- 로깅 ---
# LOG_LEVEL=INFO                    # DEBUG | INFO | WARN | ERROR
